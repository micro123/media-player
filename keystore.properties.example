# Copy to keystore.properties and replace the passwords with your local values.
# storeFile is relative to the project root; never commit the actual keystore or passwords.
storeFile=.signing/media-player-release.keystore
storeType=PKCS12
keyAlias=media-player
storePassword=REPLACE_WITH_YOUR_STORE_PASSWORD
keyPassword=REPLACE_WITH_YOUR_KEY_PASSWORD
