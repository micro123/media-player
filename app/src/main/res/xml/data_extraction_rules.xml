<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
  <!-- Document URI grants are device-specific, so do not transfer their recent list. -->
  <cloud-backup>
    <exclude domain="sharedpref" path="." />
  </cloud-backup>
  <device-transfer>
    <exclude domain="sharedpref" path="." />
  </device-transfer>
</data-extraction-rules>
